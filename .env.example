# Application
APP_NAME=maie
ENVIRONMENT=development
DEBUG=false

# Database
SQLITE_PATH=database/listings.db

# Search behavior
SEARCH_INTERVAL=15
SEARCH_RADIUS=25

# Notifications
DISCORD_WEBHOOK=
TELEGRAM_TOKEN=

# Opportunity thresholds
MINIMUM_FLIPSCORE=60
MINIMUM_EXPECTED_PROFIT=20.0

# Logging
LOGGING_LEVEL=INFO

# Collector and category enablement
ENABLED_COLLECTORS=craigslist
ENABLED_CATEGORIES=electronics,tools
